# Configuration Apache — hébergement mutualisé OVH
# À déposer dans le même dossier que index.html.
# Chaque bloc est protégé par <IfModule> : si un module manque, il est ignoré
# au lieu de provoquer une erreur 500.

# ---------------------------------------------------------------- page par défaut
DirectoryIndex index.html index.htm

# ---------------------------------------------------------------- encodage
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddCharset UTF-8 .html .css .js
</IfModule>

# ---------------------------------------------------------------- HTTPS et redirection du domaine
# Force le passau'une fois lecertificat SSL
# délivré par OVL » du manager).
#
# ATTENTION — pis mutualisés OVHconfigurés avec un
# « dossier raciif d'uneRewriteRule est évalué sur le
# chemin interneom du dossier.Reconstruire l'adresse
# avec $1 produinnet.bzh/genea/au lieu de la racine.
# %{REQUEST_URI}in public : c'est lui qu'il faut utiliser.
<IfModule mod_re
  RewriteEngine On

  # Ne jamais rediriger le dossier de validation ACME :
c'est par lui qu
  # Let's Encrypt vérifie le domaine avant d'émettre le
certificat. Une
  # redirection à cet endroit fait échouer la délivrance.
Cette exclusion
  # s'applique aux deux règles ci-dessous, pas seulement au
forçage HTTPS.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ EST_URI}[R=301,L]

  # Redirection 301 permanente : genea.bonnet.bzh est intégré à bonnet
  # et remplacé par la page /genealogie (contenu repris à
l'identique, ave
  # traduction anglaise ajoutée). Ce dossier n'a jamais eu
qu'une seule pag
  # sa remplaçante aussi n'en a qu'une seule : toute URL
demandée ici, qu
  # que soit le chemin, renvoie donc vers cette même page
unique, sans
  # tentative de faire correspondre un chemin à un autre.
  RewriteCond %{wn/
  RewriteRule ^ https://bonnet.bzh/genealogie/ [R=301,L]
</IfModule>

# -------------------------------------- compression
<IfModule mod_de
  AddOutputFilterByType DEFLATE text/html text/plain
text/css text/xm
  AddOutputFilterByType DEFLATE application/javascript
application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -------------------------------------- cache navigateur
<IfModule mod_ex
  ExpiresActive On
  ExpiresByType our"
  ExpiresByType image/png "access plus 1 month"              ExpiresByType month"
  ExpiresByType image/svg+xml "access plus 1 month"          ExpiresByType nth"
</IfModule>                                                
# ---------------------------------------------------------------- en-têtes
<IfModule mod_headers.c>       Header set X-Cff"
  Header set Referrer-Policy "strict-origin-w
  Header always unset X-Powered-By
</IfModule>

# -------------------------------------- divers
ServerSignature
Options -Indexes
